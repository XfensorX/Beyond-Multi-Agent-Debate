#!/bin/bash
#SBATCH --job-name=social_studies_experiment
#SBATCH --time=72:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=12G
#SBATCH --output=%x-%j.out
#SBATCH --exclude=pascal-node03.l3s.intra
# FIXME: include node03 if working again


set -euo pipefail

: "${EXPERIMENT_NAME}"

source $PROJECT_DIR/.venv/bin/activate
cd $PROJECT_DIR

uv sync
uv run source/cli.py +experiment=$EXPERIMENT_NAME
